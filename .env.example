# ===================================================
# ResumeZ AI — Production Environment Configuration
# ===================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Server-Side AI Secrets (REQUIRED for AI features)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Server-Side Supabase (Private — NEVER expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Client-Side Supabase (Public — Safe for browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key

# Admin Accounts (Comma-separated whitelisted emails)
ADMIN_EMAILS=thenikhilbisht@gmail.com,admin@resumez.ai

# Optional: GitHub API Token (Increases rate limit from 60 to 5000 requests/hour)
GITHUB_TOKEN=
